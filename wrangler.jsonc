{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hidratelens",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "HIDRATELENS", "id": "REPLACE_WITH_YOUR_KV_ID" }
  ],
  "observability": { "enabled": true }
}
